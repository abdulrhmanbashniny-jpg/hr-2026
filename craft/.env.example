# ── Core ──────────────────────────────────────────────
DATABASE_URL=postgres://hirfa:hirfa@localhost:5432/hirfa
# DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false
# DATABASE_POOL_MAX=5
AUTH_SECRET=                     # 32+ random characters (openssl rand -base64 48)
APP_ENCRYPTION_KEY=              # 32+ random characters, encrypts national IDs and voucher codes
APP_URL=http://localhost:3000
CRON_SECRET=

# ── SMS (OTP) ─────────────────────────────────────────
SMS_DRIVER=console               # console | unifonic | twilio
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ── Storage ───────────────────────────────────────────
STORAGE_DRIVER=database          # database | s3 | local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=                     # Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=           # optional CDN base for public media, e.g. https://media.hirfa.sa

# ── Invoice AI extraction (Claude vision) ─────────────
ANTHROPIC_API_KEY=
INVOICE_AI_MODEL=claude-opus-5-5

# ── Web Push (npm run vapid) ──────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@hirfa.sa

# ── Google Wallet (optional) ──────────────────────────
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=

# ── Seed ──────────────────────────────────────────────
SEED_ADMIN_PHONE=+966500000001
SEED_ON_BUILD=false
