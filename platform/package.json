{
  "name": "mutabaa-platform",
  "version": "3.6.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "npm run db:migrate && if [ \"$SEED_ON_BUILD\" = \"true\" ]; then npm run db:seed; fi && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "tokens": "tsx scripts/build-tokens.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "samples": "tsx scripts/generate-samples.ts",
    "job:daily": "tsx scripts/daily.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1153.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "jose": "^6.2.13",
    "lucide-react": "^1.60.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.19.1",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
