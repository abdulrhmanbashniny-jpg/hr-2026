# ───────────── Required ─────────────
# PostgreSQL 14+ connection string
DATABASE_URL=postgres://mutabaa:mutabaa@localhost:5432/mutabaa
# Set DATABASE_SSL=true for managed databases (Supabase, Neon, RDS…)
DATABASE_SSL=false

# Signs session cookies. Generate with: openssl rand -base64 48
AUTH_SECRET=
# Encrypts tenant SMTP passwords and WhatsApp tokens at rest (AES-256-GCM). Generate with: openssl rand -base64 48
APP_ENCRYPTION_KEY=
# Public base URL, used in e-mails, Telegram buttons, share links and payment callbacks
APP_URL=http://localhost:3000

# ───────────── Scheduler ─────────────
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/daily (see vercel.json).
CRON_SECRET=

# ───────────── Document storage ─────────────
# Only document-hub attachments are stored. Government Excel uploads are parsed in memory and discarded.
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./storage
# S3-compatible (AWS S3, Cloudflare R2, MinIO…) when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ───────────── Platform e-mail (password resets, invitations, default sender) ─────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mutabaa <no-reply@example.com>"

# ───────────── Telegram bot (one bot for the whole platform) ─────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random string; Telegram echoes it in X-Telegram-Bot-Api-Secret-Token. Register the webhook from /admin/system.
TELEGRAM_WEBHOOK_SECRET=

# ───────────── Payments (Moyasar — mada, Apple Pay, cards) ─────────────
# Leave empty to run with manual bank-transfer activation approved from /admin/payments.
MOYASAR_SECRET_KEY=
VAT_PERCENT=15

# ───────────── Subscriptions ─────────────
TRIAL_DAYS=7

# ───────────── Seed (npm run db:seed) ─────────────
SEED_ADMIN_EMAIL=admin@mutabaa.local
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=Demo@2026pass
